<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.AdminDashboard">

    <!-- TOP: Header -->
    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #2c3e50;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Admin Dashboard" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Button text="Home" onAction="#goToHome"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 5 15;"/>
                <Button text="↻ Refresh All" onAction="#refreshAll"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 5 15;"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: TabPane -->
    <center>
        <TabPane style="-fx-padding: 15;">

            <!-- TAB 1: PENDING ADS -->
            <Tab text="📋 Pending Ads" closable="false">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="pendingCountLabel" style="-fx-font-weight: bold;"/>
                        <Button text="Approve" onAction="#approveAd"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                        <Button text="Reject" onAction="#rejectAd"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    </HBox>

                    <TableView fx:id="pendingAdsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="pendingIdCol" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="pendingTitleCol" text="Title" prefWidth="250"/>
                            <TableColumn fx:id="pendingOwnerCol" text="Owner" prefWidth="150"/>
                            <TableColumn fx:id="pendingPriceCol" text="Price" prefWidth="100"/>
                            <TableColumn fx:id="pendingStatusCol" text="Status" prefWidth="100"/>
                        </columns>
                    </TableView>

                    <Label fx:id="pendingErrorLabel" style="-fx-text-fill: #e74c3c;"/>
                </VBox>
            </Tab>

            <!-- TAB 2: ALL ADS -->
            <Tab text="📄 All Ads" closable="false">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label fx:id="allAdsCountLabel" style="-fx-font-weight: bold;"/>

                    <TableView fx:id="allAdsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="allIdCol" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="allTitleCol" text="Title" prefWidth="250"/>
                            <TableColumn fx:id="allOwnerCol" text="Owner" prefWidth="150"/>
                            <TableColumn fx:id="allPriceCol" text="Price" prefWidth="100"/>
                            <TableColumn fx:id="allStatusCol" text="Status" prefWidth="100"/>
                        </columns>
                    </TableView>

                    <Button text="🗑️ Delete Selected Ad" onAction="#deleteAd"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 15;"/>

                    <Label fx:id="allAdsErrorLabel" style="-fx-text-fill: #e74c3c;"/>
                </VBox>
            </Tab>

            <!-- TAB 3: USERS -->
            <Tab text="👤 Users" closable="false">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="usersCountLabel" style="-fx-font-weight: bold;"/>
                        <Button text="Block User" onAction="#blockUser"
                                style="-fx-background-color: #e67e22; -fx-text-fill: white;"/>
                        <Button text="Unblock User" onAction="#unblockUser"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                    </HBox>

                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="userIdCol" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="userUsernameCol" text="Username" prefWidth="120"/>
                            <TableColumn fx:id="userFullNameCol" text="Full Name" prefWidth="150"/>
                            <TableColumn fx:id="userEmailCol" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="userStatusCol" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="userRoleCol" text="Role" prefWidth="80"/>
                        </columns>
                    </TableView>

                    <Label fx:id="usersErrorLabel" style="-fx-text-fill: #e74c3c;"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
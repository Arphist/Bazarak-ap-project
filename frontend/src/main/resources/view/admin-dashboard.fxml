<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.AdminDashboard">

    <!-- TOP: Header -->
    <top>
        <VBox spacing="8" style="-fx-padding: 15 25; -fx-background-color: #ffffff; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Administration" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↻ Refresh" onAction="#refreshAll"
                        style="-fx-background-color: transparent; -fx-text-fill: #4a6fa5; -fx-cursor: hand; -fx-padding: 5 0;"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: TabPane -->
    <center>
        <TabPane style="-fx-padding: 15 20 20 20; -fx-background-color: transparent; -fx-tab-min-height: 35; -fx-tab-max-height: 35; -fx-tab-min-width: 85px; -fx-tab-max-width: 85px;">

            <!-- TAB 1: PENDING ADS -->
            <Tab text="Pending" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="pendingCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Sort By:" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
                        <ComboBox fx:id="pendingSortByCombo" prefWidth="120"/>

                        <Label text="Order:" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
                        <ComboBox fx:id="pendingSortOrderCombo" prefWidth="100"/>

                        <Button text="Apply" onAction="#applyPendingSort"
                                style="-fx-background-color: #4a6fa5; -fx-text-fill: white; -fx-padding: 4 15; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="pendingAdsListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <Label fx:id="pendingErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 2: ACTIVE ADS -->
            <Tab text="Active" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="activeCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Sort By:" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
                        <ComboBox fx:id="activeSortByCombo" prefWidth="120"/>

                        <Label text="Order:" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
                        <ComboBox fx:id="activeSortOrderCombo" prefWidth="100"/>

                        <Button text="Apply" onAction="#applyActiveSort"
                                style="-fx-background-color: #4a6fa5; -fx-text-fill: white; -fx-padding: 4 15; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="activeAdsListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <Label fx:id="activeErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 3: REJECTED ADS -->
            <Tab text="Rejected" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="rejectedCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Sort By:" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
                        <ComboBox fx:id="rejectedSortByCombo" prefWidth="120"/>

                        <Label text="Order:" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
                        <ComboBox fx:id="rejectedSortOrderCombo" prefWidth="100"/>

                        <Button text="Apply" onAction="#applyRejectedSort"
                                style="-fx-background-color: #4a6fa5; -fx-text-fill: white; -fx-padding: 4 15; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="rejectedAdsListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <Label fx:id="rejectedErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 4: SOLD ADS -->
            <Tab text="Sold" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="soldCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Sort By:" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
                        <ComboBox fx:id="soldSortByCombo" prefWidth="120"/>

                        <Label text="Order:" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
                        <ComboBox fx:id="soldSortOrderCombo" prefWidth="100"/>

                        <Button text="Apply" onAction="#applySoldSort"
                                style="-fx-background-color: #4a6fa5; -fx-text-fill: white; -fx-padding: 4 15; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="soldAdsListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <Label fx:id="soldErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 5: DELETED ADS -->
            <Tab text="Deleted" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="deletedCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Sort By:" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
                        <ComboBox fx:id="deletedSortByCombo" prefWidth="120"/>

                        <Label text="Order:" style="-fx-text-fill: #6c757d; -fx-font-size: 12;"/>
                        <ComboBox fx:id="deletedSortOrderCombo" prefWidth="100"/>

                        <Button text="Apply" onAction="#applyDeletedSort"
                                style="-fx-background-color: #4a6fa5; -fx-text-fill: white; -fx-padding: 4 15; -fx-background-radius: 4; -fx-cursor: hand;"/>

                        <Button text="Restore Selected" onAction="#restoreAd"
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                        <Button text="Delete Selected" onAction="#deleteAd"
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="deletedAdsListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <Label fx:id="deletedErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 6: USERS -->
            <Tab text="Users" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="usersCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Block User" onAction="#blockUser"
                                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                        <Button text="Unblock User" onAction="#unblockUser"
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;">
                        <columns>
                            <TableColumn fx:id="userIdCol" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="userUsernameCol" text="Username" prefWidth="120"/>
                            <TableColumn fx:id="userFullNameCol" text="Full Name" prefWidth="150"/>
                            <TableColumn fx:id="userEmailCol" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="userStatusCol" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="userRoleCol" text="Role" prefWidth="80"/>
                        </columns>
                    </TableView>

                    <Label fx:id="usersErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>
            <!-- TAB 7: CITIES -->
            <Tab text="Cities" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <!-- Add City Section -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="cityNameField" promptText="City Name" prefWidth="200"
                                   style="-fx-padding: 6; -fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #ced4da;"/>
                        <TextField fx:id="cityProvinceField" promptText="Province (optional)" prefWidth="200"
                                   style="-fx-padding: 6; -fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #ced4da;"/>
                        <Button text="➕ Add City" onAction="#handleAddCity"
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- City List -->
                    <ListView fx:id="cityListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <!-- Actions -->
                    <HBox spacing="10">
                        <Button text="✏️ Edit Selected" onAction="#handleEditCity"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                        <Button text="🗑️ Delete Selected" onAction="#handleDeleteCity"
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <Label fx:id="cityErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 8: CATEGORIES -->
            <Tab text="Categories" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <!-- Add Category Section -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="categoryNameField" promptText="Category Name" prefWidth="200"
                                   style="-fx-padding: 6; -fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #ced4da;"/>
                        <TextField fx:id="categoryDescriptionField" promptText="Description (optional)" prefWidth="250"
                                   style="-fx-padding: 6; -fx-background-radius: 4; -fx-border-radius: 4; -fx-border-color: #ced4da;"/>
                        <ComboBox fx:id="categoryParentCombo" promptText="Parent (optional)" prefWidth="150"/>
                        <Button text="➕ Add Category" onAction="#handleAddCategory"
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Category List -->
                    <ListView fx:id="categoryListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <!-- Actions -->
                    <HBox spacing="10">
                        <Button text="✏️ Edit Selected" onAction="#handleEditCategory"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                        <Button text="🗑️ Delete Selected" onAction="#handleDeleteCategory"
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <Label fx:id="categoryErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB: DASHBOARD STATISTICS -->
            <Tab text="Dashboard" closable="false">
                <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <Label text="📊 Dashboard Statistics" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>

                    <!-- Stats Grid -->
                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- Row 1: Total, Pending, Active -->
                        <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0"
                              style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label text="📦 Total Ads" style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
                            <Label fx:id="totalAdsLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0"
                              style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label text="⏳ Pending" style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
                            <Label fx:id="pendingCountLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0"
                              style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label text="✅ Active" style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
                            <Label fx:id="activeCountLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #28a745;"/>
                        </VBox>

                        <!-- Row 2: Rejected, Sold, Deleted -->
                        <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1"
                              style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label text="❌ Rejected" style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
                            <Label fx:id="rejectedCountLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #dc3545;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1"
                              style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label text="💰 Sold" style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
                            <Label fx:id="soldCountLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #17a2b8;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1"
                              style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label text="🗑️ Deleted" style="-fx-font-size: 12; -fx-text-fill: #6c757d;"/>
                            <Label fx:id="deletedCountLabel" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #6c757d;"/>
                        </VBox>

                    </GridPane>

                    <Label fx:id="dashboardErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>


        </TabPane>
    </center>

</BorderPane>
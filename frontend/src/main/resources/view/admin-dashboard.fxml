<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.AdminDashboard">

    <!-- TOP: Header -->
    <top>
        <VBox spacing="8" styleClass="header-bar">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Administration Dashboard" styleClass="heading-title" style="-fx-font-size: 18;"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button text="↻ Refresh" onAction="#refreshAll" styleClass="button-secondary"/>

                <MenuButton text="..." styleClass="menu-button" style="-fx-font-size: 12px; -fx-font-weight: bold;">
                    <items>
                        <MenuItem text="🚪 Sign Out" onAction="#handleLogout"/>
                    </items>
                </MenuButton>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: TabPane -->
    <center>
        <TabPane styleClass="centered-tabs" style="-fx-tab-min-height: 35;">
            <padding>
                <Insets top="15" right="20" bottom="20" left="20"/>
            </padding>

            <!-- TAB 1: DASHBOARD -->
            <Tab text="Dashboard" closable="false">
                <SplitPane dividerPositions="0.70" style="-fx-background-color: transparent;">
                    <!-- LEFT: StackPane with switchable views -->
                    <StackPane>

                        <!-- Dashboard Stats View -->
                        <VBox fx:id="dashboardStatsView" spacing="15" styleClass="filter-card">
                            <padding>
                                <Insets top="20" right="20" bottom="20" left="20"/>
                            </padding>
                            <Label text="📊 Statistics" styleClass="heading-title" style="-fx-font-size: 16;"/>

                            <GridPane hgap="15" vgap="15">
                                <columnConstraints>
                                    <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                                    <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                                    <ColumnConstraints halignment="CENTER" hgrow="ALWAYS"/>
                                </columnConstraints>

                                <!-- Total Ads -->
                                <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="stat-card">
                                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                    <Label text="📦 Total Ads" styleClass="sub-title"/>
                                    <Label fx:id="totalAdsLabel" styleClass="heading-title" style="-fx-text-fill: #ffffff;"/>
                                </VBox>

                                <!-- Pending -->
                                <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="stat-card">
                                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                    <Label text="Pending" styleClass="sub-title"/>
                                    <Label fx:id="pendingCountLabel" styleClass="heading-title" style="-fx-text-fill: #F39C12;"/>
                                </VBox>

                                <!-- Active -->
                                <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="stat-card">
                                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                    <Label text="Active" styleClass="sub-title"/>
                                    <Label fx:id="activeCountLabel" styleClass="heading-title" style="-fx-text-fill: #2ECC71;"/>
                                </VBox>

                                <!-- Rejected -->
                                <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="stat-card">
                                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                    <Label text="Rejected" styleClass="sub-title"/>
                                    <Label fx:id="rejectedCountLabel" styleClass="heading-title" style="-fx-text-fill: #E74C3C;"/>
                                </VBox>

                                <!-- Sold -->
                                <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="stat-card">
                                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                    <Label text="Sold" styleClass="sub-title"/>
                                    <Label fx:id="soldCountLabel" styleClass="heading-title" style="-fx-text-fill: #3498DB;"/>
                                </VBox>

                                <!-- Deleted -->
                                <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="stat-card">
                                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                    <Label text="Deleted" styleClass="sub-title"/>
                                    <Label fx:id="deletedCountLabel" styleClass="heading-title" style="-fx-text-fill: #95A5A6;"/>
                                </VBox>
                            </GridPane>

                            <Label fx:id="dashboardErrorLabel" styleClass="error-label"/>
                        </VBox>

                        <!-- Cities View -->
                        <VBox fx:id="citiesView" spacing="8" styleClass="filter-card">
                            <padding>
                                <Insets top="15" right="15" bottom="15" left="15"/>
                            </padding>

                            <Label text="Cities" style="-fx-font-weight: bold; -fx-text-fill: #E0E0E0; -fx-font-size: 14px;"/>

                            <!-- Search Bar -->
                            <HBox spacing="5">
                                <TextField fx:id="citySearchField" promptText="Search cities..." HBox.hgrow="ALWAYS" styleClass="text-field"/>
                                <Button text="🔍" onAction="#searchCities" styleClass="button-secondary"/>
                            </HBox>

                            <!-- List View -->
                            <ListView fx:id="cityListView" prefHeight="400" VBox.vgrow="ALWAYS" styleClass="list-view"/>

                            <!-- ALL IN ONE LINE: Fields + Buttons -->
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <TextField fx:id="cityNameField" promptText="City Name" prefWidth="180" styleClass="text-field"/>
                                <TextField fx:id="cityProvinceField" promptText="Province" prefWidth="180" styleClass="text-field"/>

                                <Separator orientation="VERTICAL" style="-fx-background-color: #333333;"/>

                                <Button text="➕ Add" onAction="#handleAddCity" styleClass="button-primary" prefWidth="80"/>
                                <Button text="Edit" onAction="#handleEditCity" styleClass="button-edit" prefWidth="80"/>
                                <Button text="Delete" onAction="#handleDeleteCity" styleClass="button-delete" prefWidth="80"/>
                            </HBox>

                            <Label fx:id="cityErrorLabel" styleClass="error-label"/>
                        </VBox>

                        <!-- Categories View -->
                        <VBox fx:id="categoriesView" spacing="8" styleClass="filter-card">
                            <padding>
                                <Insets top="15" right="15" bottom="15" left="15"/>
                            </padding>

                            <Label text="Categories" style="-fx-font-weight: bold; -fx-text-fill: #E0E0E0; -fx-font-size: 14px;"/>

                            <!-- Search Bar -->
                            <HBox spacing="5">
                                <TextField fx:id="categorySearchField" promptText="Search categories..." HBox.hgrow="ALWAYS" styleClass="text-field"/>
                                <Button text="🔍" onAction="#searchCategories" styleClass="button-secondary"/>
                            </HBox>

                            <!-- List View -->
                            <ListView fx:id="categoryListView" prefHeight="400" VBox.vgrow="ALWAYS" styleClass="list-view"/>

                            <!-- ALL IN ONE LINE: Fields + Parent Combo + Buttons -->
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <TextField fx:id="categoryNameField" promptText="Name" prefWidth="180" styleClass="text-field"/>
                                <TextField fx:id="categoryDescriptionField" promptText="Description" prefWidth="180" styleClass="text-field"/>
                                <ComboBox fx:id="categoryParentCombo" promptText="Parent" prefWidth="180" styleClass="combo-box"/>

                                <Separator orientation="VERTICAL" style="-fx-background-color: #333333;"/>

                                <Button text="Add" onAction="#handleAddCategory" styleClass="button-primary" prefWidth="80"/>
                                <Button text="Edit" onAction="#handleEditCategory" styleClass="button-edit" prefWidth="80"/>
                                <Button text="Delete" onAction="#handleDeleteCategory" styleClass="button-delete" prefWidth="80"/>
                            </HBox>

                            <Label fx:id="categoryErrorLabel" styleClass="error-label"/>
                        </VBox>

                        <!-- Specifications View -->
                        <VBox fx:id="specificationsView" spacing="8" styleClass="filter-card">
                            <Label text="Specifications" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #E0E0E0;"/>

                            <ComboBox fx:id="specCategoryCombo" promptText="Select category"
                                      onAction="#onSpecCategorySelected"
                                      styleClass="combo-box"
                                      HBox.hgrow="ALWAYS"/>

                            <ListView fx:id="specificationsListView" prefHeight="600" VBox.vgrow="NEVER"
                                      styleClass="list-view"/>

                            <VBox spacing="5" style="-fx-padding: 5; -fx-background-color: #1E1E1E; -fx-border-color: #2A2A2A; -fx-border-radius: 4;">
                                <Label text="Add New Spec" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #9E9E9E;"/>
                                <HBox spacing="5">
                                    <TextField fx:id="specNameField" promptText="Name" prefWidth="80" styleClass="text-field"/>
                                    <ComboBox fx:id="specTypeCombo" promptText="Type" prefWidth="80" styleClass="combo-box"/>
                                </HBox>
                                <HBox spacing="5">
                                    <TextField fx:id="specOptionsField" promptText="Options (comma)" HBox.hgrow="ALWAYS" styleClass="text-field"/>
                                    <CheckBox fx:id="specRequiredCheck" text="Req" style="-fx-text-fill: #9E9E9E;"/>
                                </HBox>
                            </VBox>

                            <HBox spacing="5">
                                <Button text="Add" onAction="#handleAddSpecification" styleClass="button-primary"/>
                                <Button text="Edit" onAction="#handleEditSpecification" styleClass="button-edit"/>
                                <Button text="Delete" onAction="#handleDeleteSpecification" styleClass="button-delete"/>
                            </HBox>

                            <Label fx:id="specErrorLabel" styleClass="error-label"/>
                        </VBox>

                    </StackPane>

                    <!-- RIGHT: Navigation buttons -->
                    <VBox spacing="15" styleClass="filter-card">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                        <Button text="Dashboard" onAction="#showDashboard" styleClass="nav-button" maxWidth="Infinity"/>
                        <Button text="Cities" onAction="#showCities" styleClass="nav-button" maxWidth="Infinity"/>
                        <Button text="Categories" onAction="#showCategories" styleClass="nav-button" maxWidth="Infinity"/>
                        <Button text="Specifications" onAction="#showSpecifications" styleClass="nav-button" maxWidth="Infinity"/>
                    </VBox>
                </SplitPane>
            </Tab>

            <!-- TAB 2: PENDING ADS -->
            <Tab text="Pending" closable="false">
                <VBox spacing="12" styleClass="filter-card">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Sort By:" style="-fx-text-fill: #E0E0E0;"/>
                        <ComboBox fx:id="pendingSortByCombo" prefWidth="120" styleClass="combo-box"/>
                        <Label text="Order:" style="-fx-text-fill: #E0E0E0;"/>
                        <ComboBox fx:id="pendingSortOrderCombo" prefWidth="100" styleClass="combo-box"/>
                        <Button text="Apply" onAction="#applyPendingSort" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="pendingAdsListView" VBox.vgrow="ALWAYS" styleClass="list-view"/>
                    <Label fx:id="pendingErrorLabel" styleClass="error-label"/>
                </VBox>
            </Tab>

            <!-- TAB 3: ACTIVE ADS -->
            <Tab text="Active" closable="false">
                <VBox spacing="12" styleClass="filter-card">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Sort By:" style="-fx-text-fill: #E0E0E0;"/>
                        <ComboBox fx:id="activeSortByCombo" prefWidth="120" styleClass="combo-box"/>
                        <Label text="Order:" style="-fx-text-fill: #E0E0E0;"/>
                        <ComboBox fx:id="activeSortOrderCombo" prefWidth="100" styleClass="combo-box"/>
                        <Button text="Apply" onAction="#applyActiveSort" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="activeAdsListView" VBox.vgrow="ALWAYS" styleClass="list-view"/>
                    <Label fx:id="activeErrorLabel" styleClass="error-label"/>
                </VBox>
            </Tab>

            <!-- TAB 4: REJECTED ADS -->
            <Tab text="Rejected" closable="false">
                <VBox spacing="12" styleClass="filter-card">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Sort By:" style="-fx-text-fill: #E0E0E0;"/>
                        <ComboBox fx:id="rejectedSortByCombo" prefWidth="120" styleClass="combo-box"/>
                        <Label text="Order:" style="-fx-text-fill: #E0E0E0;"/>
                        <ComboBox fx:id="rejectedSortOrderCombo" prefWidth="100" styleClass="combo-box"/>
                        <Button text="Apply" onAction="#applyRejectedSort" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="rejectedAdsListView" VBox.vgrow="ALWAYS" styleClass="list-view"/>
                    <Label fx:id="rejectedErrorLabel" styleClass="error-label"/>
                </VBox>
            </Tab>

            <!-- TAB 5: SOLD ADS -->
            <Tab text="Sold" closable="false">
                <VBox spacing="12" styleClass="filter-card">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Sort By:" style="-fx-text-fill: #E0E0E0;"/>
                        <ComboBox fx:id="soldSortByCombo" prefWidth="120" styleClass="combo-box"/>
                        <Label text="Order:" style="-fx-text-fill: #E0E0E0;"/>
                        <ComboBox fx:id="soldSortOrderCombo" prefWidth="100" styleClass="combo-box"/>
                        <Button text="Apply" onAction="#applySoldSort" styleClass="button-primary"/>
                    </HBox>
                    <ListView fx:id="soldAdsListView" VBox.vgrow="ALWAYS" styleClass="list-view"/>
                    <Label fx:id="soldErrorLabel" styleClass="error-label"/>
                </VBox>
            </Tab>

            <!-- TAB 6: DELETED ADS -->
            <Tab text="Deleted" closable="false">
                <VBox spacing="12" styleClass="filter-card">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Sort By:" style="-fx-text-fill: #E0E0E0;"/>
                        <ComboBox fx:id="deletedSortByCombo" prefWidth="120" styleClass="combo-box"/>
                        <Label text="Order:" style="-fx-text-fill: #E0E0E0;"/>
                        <ComboBox fx:id="deletedSortOrderCombo" prefWidth="100" styleClass="combo-box"/>
                        <Button text="Apply" onAction="#applyDeletedSort" styleClass="button-primary"/>
                        <Button text="Restore Selected" onAction="#restoreAd" styleClass="button-secondary"/>
                        <Button text="Delete Selected" onAction="#deleteAd" styleClass="button-secondary"/>
                    </HBox>
                    <ListView fx:id="deletedAdsListView" VBox.vgrow="ALWAYS" styleClass="list-view"/>
                    <Label fx:id="deletedErrorLabel" styleClass="error-label"/>
                </VBox>
            </Tab>

            <!-- TAB 7: USERS -->
            <Tab text="Users" closable="false">
                <VBox spacing="12" styleClass="filter-card">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="usersCountLabel" style="-fx-font-weight: bold; -fx-text-fill: #E0E0E0;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Block User" onAction="#blockUser" styleClass="button-secondary"/>
                        <Button text="Unblock User" onAction="#unblockUser" styleClass="button-primary"/>
                    </HBox>
                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="userIdCol" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="userUsernameCol" text="Username" prefWidth="120"/>
                            <TableColumn fx:id="userFullNameCol" text="Full Name" prefWidth="150"/>
                            <TableColumn fx:id="userEmailCol" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="userStatusCol" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="userRoleCol" text="Role" prefWidth="80"/>
                        </columns>
                    </TableView>
                    <Label fx:id="usersErrorLabel" styleClass="error-label"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.AdminDashboard">

    <!-- TOP: Header -->
    <top>
        <VBox spacing="8" style="-fx-padding: 15 25; -fx-background-color: #ffffff; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Administration" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↻ Refresh" onAction="#refreshAll"
                        style="-fx-background-color: transparent; -fx-text-fill: #4a6fa5; -fx-cursor: hand; -fx-padding: 5 0;"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: TabPane -->
    <center>
        <TabPane style="-fx-padding: 15 20 20 20; -fx-background-color: transparent; -fx-tab-min-height: 35; -fx-tab-max-height: 35; -fx-tab-min-width: 85px; -fx-tab-max-width: 85px;">

            <!-- TAB 1: PENDING ADS -->
            <Tab text="Pending" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="pendingCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Approve Selected" onAction="#approveAd"
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                        <Button text="Reject Selected" onAction="#rejectAd"
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="pendingAdsListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <Label fx:id="pendingErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 2: ACTIVE ADS -->
            <Tab text="Active" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="activeCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Delete Selected" onAction="#deleteAd"
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="activeAdsListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <Label fx:id="activeErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 3: REJECTED ADS -->
            <Tab text="Rejected" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="rejectedCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Delete Selected" onAction="#deleteAd"
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="rejectedAdsListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <Label fx:id="rejectedErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 4: SOLD ADS -->
            <Tab text="Sold" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="soldCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Delete Selected" onAction="#deleteAd"
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="soldAdsListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <Label fx:id="soldErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 5: DELETED ADS -->
            <Tab text="Deleted" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="deletedCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Delete Selected" onAction="#deleteAd"
                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <ListView fx:id="deletedAdsListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;"/>

                    <Label fx:id="deletedErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- TAB 6: USERS -->
            <Tab text="Users" closable="false">
                <VBox spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-radius: 4;">

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label fx:id="usersCountLabel" style="-fx-text-fill: #495057; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Block User" onAction="#blockUser"
                                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                        <Button text="Unblock User" onAction="#unblockUser"
                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 4; -fx-cursor: hand;"/>
                    </HBox>

                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-radius: 4;">
                        <columns>
                            <TableColumn fx:id="userIdCol" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="userUsernameCol" text="Username" prefWidth="120"/>
                            <TableColumn fx:id="userFullNameCol" text="Full Name" prefWidth="150"/>
                            <TableColumn fx:id="userEmailCol" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="userStatusCol" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="userRoleCol" text="Role" prefWidth="80"/>
                        </columns>
                    </TableView>

                    <Label fx:id="usersErrorLabel" style="-fx-text-fill: #dc3545; -fx-font-size: 12;"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
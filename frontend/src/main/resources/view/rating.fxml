<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.RatingController"
            stylesheets="@styles.css">

    <!-- TOP: Header -->
    <top>
        <VBox spacing="10" styleClass="header-bar" style="-fx-padding: 15;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="← Back" onAction="#goBack" styleClass="button-secondary"/>
                <Label text="Rate Seller" styleClass="heading-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Home" onAction="#goToHome" styleClass="button-primary"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">

            <!-- Seller Info -->
            <VBox spacing="5" styleClass="stat-card" style="-fx-padding: 15;">
                <Label fx:id="sellerNameLabel" styleClass="heading-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="averageRatingLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #FFB300;"/>
                    <Label fx:id="totalRatingsLabel" styleClass="sub-title"/>
                </HBox>
            </VBox>

            <!-- Ratings List -->
            <VBox spacing="5">
                <Label text="All Ratings" styleClass="sub-title" style="-fx-font-weight: bold;"/>
                <ListView fx:id="ratingsListView" prefHeight="200" styleClass="list-view"/>
            </VBox>

            <!-- Submit Rating -->
            <VBox spacing="10" styleClass="filter-card" style="-fx-padding: 15;">
                <Label text="Submit Your Rating" styleClass="heading-title" style="-fx-font-size: 16px;"/>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Score:"/>
                    <ComboBox fx:id="scoreComboBox" prefWidth="80" styleClass="combo-box"/>
                </HBox>

                <TextArea fx:id="commentTextArea" promptText="Optional comment..." prefHeight="80" wrapText="true" styleClass="text-field"/>

                <Button fx:id="submitRatingButton" text="Submit Rating" onAction="#submitRating" styleClass="button-primary"/>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel" styleClass="error-label"/>

        </VBox>
    </center>

</BorderPane>
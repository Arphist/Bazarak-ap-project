<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.ConversationController"
            stylesheets="@styles.css">

    <!-- TOP: Navigation Header -->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header-bar" style="-fx-padding: 15 20;">
            <Button text="← Back" onAction="#goBack" styleClass="button-secondary"/>
            <VBox spacing="2">
                <Label fx:id="sellerNameLabel" text="Seller Chat" styleClass="heading-title" style="-fx-font-size: 16px;"/>
                <Label fx:id="adTitleLabel" text="Ad Reference" styleClass="sub-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- CENTER: Message History List -->
    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <ListView fx:id="chatListView" VBox.vgrow="ALWAYS" styleClass="list-view"/>
            <Label fx:id="errorLabel" styleClass="error-label"/>
        </VBox>
    </center>

    <!-- BOTTOM: Message Input Area -->
    <bottom>
        <HBox spacing="10" alignment="CENTER" styleClass="header-bar" style="-fx-padding: 15 20;">
            <TextField fx:id="messageInputField" promptText="Type a message..." HBox.hgrow="ALWAYS" styleClass="text-field"/>
            <Button text="Send ➔" onAction="SendMessage" styleClass="button-primary"/>
        </HBox>
    </bottom>

</BorderPane>
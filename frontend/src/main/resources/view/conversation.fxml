<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.ConversationController">

    <!-- TOP: Header -->
    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #2c3e50;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="← Back" onAction="#goBack"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14;"/>
                <Label text="Messages" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Button text="Home" onAction="#goToHome"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 5 15;"/>
                <Button text="↻" onAction="#refreshConversations"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18;"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: Conversations + Messages -->
    <center>
        <HBox spacing="10" style="-fx-padding: 15;">

            <!-- Left: Conversation List -->
            <VBox spacing="10" HBox.hgrow="NEVER" prefWidth="300">
                <Label text="Conversations" style="-fx-font-weight: bold; -fx-font-size: 14;"/>
                <ListView fx:id="conversationListView" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>
            </VBox>

            <!-- Right: Chat Area -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label fx:id="conversationTitleLabel" style="-fx-font-weight: bold; -fx-font-size: 14;"/>

                <ListView fx:id="messageListView" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>

                <HBox spacing="10">
                    <TextArea fx:id="messageInput" promptText="Type a message..." HBox.hgrow="ALWAYS"
                              prefHeight="60" wrapText="true"
                              style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>
                    <Button text="Send"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"/>
                </HBox>

                <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12;"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>
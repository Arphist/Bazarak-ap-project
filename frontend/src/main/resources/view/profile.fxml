<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.ProfileController"
            stylesheets="@styles.css">

    <!-- TOP: Fixed Back Button -->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header-bar" style="-fx-padding: 15 20;">
            <Button text="← Back" onAction="#goBack" styleClass="button-secondary"/>
            <Label text="Profile" styleClass="heading-title"/>
        </HBox>
    </top>

    <!-- CENTER: Scrollable Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="12" alignment="TOP_CENTER" style="-fx-padding: 30 40 40 40;">

                <!-- Profile Header -->
                <GridPane alignment="CENTER" hgap="0" vgap="8" style="-fx-padding: 10 0 30 0;">
                    <columnConstraints>
                        <ColumnConstraints halignment="CENTER" hgrow="NEVER"/>
                    </columnConstraints>

                    <!-- Row 0: Profile Photo - FIXED CLIP -->
                    <StackPane GridPane.rowIndex="0"
                               style="-fx-padding: 5; -fx-alignment: CENTER;">
                        <StackPane>
                            <ImageView fx:id="profileImageView"
                                       fitWidth="150"
                                       fitHeight="150"
                                       preserveRatio="true"/>
                            <clip>
                                <Circle centerX="75" centerY="75" radius="75"/>
                            </clip>
                        </StackPane>
                        <!-- Default avatar placeholder -->
                        <Label fx:id="defaultAvatarLabel"
                               text="👤"
                               style="-fx-font-size: 100; -fx-text-fill: #888888;"
                               StackPane.alignment="CENTER"/>
                    </StackPane>

                    <!-- Row 1: Spacer -->
                    <Region prefHeight="20" GridPane.rowIndex="1"/>

                    <!-- Row 2: Change Photo Button -->
                    <Button fx:id="changePhotoButton"
                            text="Change Photo"
                            onAction="#handleChangeProfilePhoto"
                            styleClass="button-secondary"
                            GridPane.rowIndex="2">
                        <padding>
                            <Insets top="8" right="20" bottom="8" left="20"/>
                        </padding>
                    </Button>

                    <!-- Row 3: Username -->
                    <Label fx:id="usernameLabel"
                           styleClass="heading-title"
                           style="-fx-padding: 8 0 0 0;"
                           GridPane.rowIndex="3"/>

                    <!-- Row 4: Time Information -->
                    <VBox spacing="2" alignment="CENTER" style="-fx-padding: 5 0;" GridPane.rowIndex="4">
                        <Label fx:id="createdAtLabel" styleClass="sub-title"/>
                        <Label fx:id="updatedAtLabel" styleClass="sub-title"/>
                        <Label fx:id="lastLoginLabel" styleClass="sub-title"/>
                    </VBox>
                </GridPane>

                <Separator style="-fx-opacity: 0.2;">
                    <padding>
                        <Insets top="5" bottom="5"/>
                    </padding>
                </Separator>

                <!-- Personal Information -->
                <VBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 5 0;">
                    <Label text="Personal Information" styleClass="sub-title" style="-fx-font-weight: bold;">
                        <padding>
                            <Insets bottom="5"/>
                        </padding>
                    </Label>

                    <TextField fx:id="fullNameField" promptText="Full Name" maxWidth="360" styleClass="text-field"/>
                    <TextField fx:id="emailField" promptText="Email" maxWidth="360" styleClass="text-field"/>
                    <TextField fx:id="phoneField" promptText="Phone Number" maxWidth="360" styleClass="text-field"/>

                    <Button text="Save Changes" onAction="#handleUpdateProfile" maxWidth="360" styleClass="button-primary">
                        <padding>
                            <Insets top="10" right="20" bottom="10" left="20"/>
                        </padding>
                    </Button>
                </VBox>

                <Separator style="-fx-opacity: 0.2;">
                    <padding>
                        <Insets top="5" bottom="5"/>
                    </padding>
                </Separator>

                <!-- Change Password -->
                <VBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 5 0;">
                    <Label text="Change Password" styleClass="sub-title" style="-fx-font-weight: bold;">
                        <padding>
                            <Insets bottom="5"/>
                        </padding>
                    </Label>

                    <!-- Old Password -->
                    <StackPane maxWidth="360">
                        <TextField fx:id="oldPasswordVisibleField" promptText="Current Password" styleClass="text-field" visible="false" managed="false"/>
                        <PasswordField fx:id="oldPasswordField" promptText="Current Password" styleClass="password-field"/>
                        <ToggleButton fx:id="oldPasswordToggle" text="👁" onAction="#toggleOldPasswordVisibility" styleClass="icon-toggle" StackPane.alignment="CENTER_RIGHT"/>
                    </StackPane>

                    <!-- New Password -->
                    <StackPane maxWidth="360">
                        <TextField fx:id="newPasswordVisibleField" promptText="New Password" styleClass="text-field" visible="false" managed="false"/>
                        <PasswordField fx:id="newPasswordField" promptText="New Password" styleClass="password-field"/>
                        <ToggleButton fx:id="newPasswordToggle" text="👁" onAction="#toggleNewPasswordVisibility" styleClass="icon-toggle" StackPane.alignment="CENTER_RIGHT"/>
                    </StackPane>

                    <!-- Confirm Password -->
                    <StackPane maxWidth="360">
                        <TextField fx:id="confirmPasswordVisibleField" promptText="Confirm New Password" styleClass="text-field" visible="false" managed="false"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirm New Password" styleClass="password-field"/>
                        <ToggleButton fx:id="confirmPasswordToggle" text="👁" onAction="#toggleConfirmPasswordVisibility" styleClass="icon-toggle" StackPane.alignment="CENTER_RIGHT"/>
                    </StackPane>

                    <Button text="Update Password" onAction="#handleChangePassword" maxWidth="360" styleClass="button-secondary">
                        <padding>
                            <Insets top="10" right="20" bottom="10" left="20"/>
                        </padding>
                    </Button>
                </VBox>

                <!-- Error Label -->
                <Label fx:id="errorLabel" text="" styleClass="error-label">
                    <padding>
                        <Insets top="5" bottom="5"/>
                    </padding>
                </Label>

                <Region prefHeight="15"/>

                <!-- Logout Button -->
                <Button text="Sign Out" onAction="#handleLogout" maxWidth="360" styleClass="button-secondary" style="-fx-border-color: #CF6679; -fx-text-fill: #CF6679;">
                    <padding>
                        <Insets top="10" right="20" bottom="10" left="20"/>
                    </padding>
                </Button>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" alignment="CENTER" stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controller.RegisterController">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Bazarak" styleClass="heading-title"/>
    <Label text="Join Bazarak marketplace" styleClass="sub-title"/>

    <VBox spacing="10" alignment="CENTER" maxWidth="320">
        <TextField fx:id="fullNameField" promptText="Full Name" maxWidth="Infinity"/>
        <TextField fx:id="usernameField" promptText="Username" maxWidth="Infinity"/>
        <TextField fx:id="emailField" promptText="Email" maxWidth="Infinity"/>
        <TextField fx:id="phoneField" promptText="Phone Number" maxWidth="Infinity"/>

        <!-- Password Field -->
        <StackPane maxWidth="Infinity">
            <TextField fx:id="passwordVisibleField" promptText="Password" visible="false" managed="false"/>
            <PasswordField fx:id="passwordField" promptText="Password"/>
            <ToggleButton fx:id="passwordToggle" text="👁" onAction="#togglePasswordVisibility"
                          styleClass="icon-toggle" StackPane.alignment="CENTER_RIGHT">
                <StackPane.margin>
                    <Insets right="5"/>
                </StackPane.margin>
            </ToggleButton>
        </StackPane>

        <!-- Confirm Password Field -->
        <StackPane maxWidth="Infinity">
            <TextField fx:id="confirmPasswordVisibleField" promptText="Confirm Password" visible="false" managed="false"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password"/>
            <ToggleButton fx:id="confirmPasswordToggle" text="👁" onAction="#toggleConfirmPasswordVisibility"
                          styleClass="icon-toggle" StackPane.alignment="CENTER_RIGHT">
                <StackPane.margin>
                    <Insets right="5"/>
                </StackPane.margin>
            </ToggleButton>
        </StackPane>
    </VBox>

    <Label fx:id="errorLabel" text="" styleClass="error-label"/>

    <VBox spacing="8" alignment="CENTER" maxWidth="320">
        <Button text="Register" onAction="#handleRegister" maxWidth="Infinity" styleClass="button-primary"/>
        <Button text="Already have an account? Login" onAction="#goToLogin" styleClass="button-link"/>
    </VBox>

</VBox>
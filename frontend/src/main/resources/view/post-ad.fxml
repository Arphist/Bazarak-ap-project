<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.CreateAdController"
            stylesheets="@styles.css">

    <!-- TOP: Back Button -->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header-bar" style="-fx-padding: 15 20;">
            <Button text="← Back" onAction="#goBack" styleClass="button-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- CENTER: Scrollable Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox spacing="15" alignment="CENTER" style="-fx-padding: 30;">

                <Label text="Create New Ad" styleClass="heading-title"/>
                <Label text="Fill in the details below" styleClass="sub-title"/>

                <!-- Title -->
                <TextField fx:id="titleField" promptText="Title *" maxWidth="500" styleClass="text-field"/>

                <!-- Description -->
                <TextArea fx:id="descriptionArea" promptText="Description *" maxWidth="500" prefHeight="120" styleClass="text-field"/>

                <!-- Price -->
                <TextField fx:id="priceField" promptText="Price (Toman) *" maxWidth="500" styleClass="text-field"/>

                <!-- Category -->
                <ComboBox fx:id="categoryCombo" maxWidth="500" promptText="Select Category" styleClass="combo-box"/>

                <ComboBox fx:id="subCategoryCombo" maxWidth="500" promptText="Select Sub-Category" styleClass="combo-box"/>

                <!-- City -->
                <ComboBox fx:id="cityCombo" maxWidth="500" promptText="Select City" styleClass="combo-box"/>

                <!-- Specifications Container -->
                <Label text="Specifications" styleClass="sub-title" style="-fx-font-weight: bold;"/>
                <VBox fx:id="specificationsContainer" spacing="8" maxWidth="500" styleClass="filter-card" style="-fx-padding: 10;"/>

                <!-- Image Upload Section -->
                <Label text="Images" styleClass="sub-title" style="-fx-font-weight: bold;"/>

                <!-- Select Images Button -->
                <Button text="📷 Select Images" onAction="#handleSelectImages" styleClass="button-secondary" maxWidth="500"/>

                <!-- Image List View -->
                <ListView fx:id="imageListView" maxWidth="500" prefHeight="80" styleClass="list-view"/>

                <!-- Error Label -->
                <Label fx:id="errorLabel" text="" styleClass="error-label"/>

                <!-- Buttons -->
                <HBox spacing="15" alignment="CENTER">
                    <Button text="Create Ad" onAction="#handleCreateAd" styleClass="button-primary"/>
                    <Button text="Cancel" onAction="#cancel" styleClass="button-secondary"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="15" alignment="CENTER" style="-fx-padding: 30; -fx-background-color: #f5f5f5;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controller.CreateAdController">

    <Label text="Create New Ad" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Label text="Fill in the details below" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>

    <!-- Title -->
    <TextField fx:id="titleField" promptText="Title *" maxWidth="500"
               style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

    <!-- Description -->
    <TextArea fx:id="descriptionArea" promptText="Description *" maxWidth="500" prefHeight="120"
              style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

    <!-- Price -->
    <TextField fx:id="priceField" promptText="Price (Toman) *" maxWidth="500"
               style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

    <!-- Category -->
    <ComboBox fx:id="categoryCombo" maxWidth="500" promptText="Select Category"
              style="-fx-padding: 5; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

    <!-- City -->
    <ComboBox fx:id="cityCombo" maxWidth="500" promptText="Select City"
              style="-fx-padding: 5; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

    <!-- Error Label -->
    <Label fx:id="errorLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12;"/>

    <!-- Buttons -->
    <HBox spacing="15" alignment="CENTER">
        <Button text="Create Ad" onAction="#handleCreateAd"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 5;"/>

        <Button text="Cancel" onAction="#cancel"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30; -fx-background-radius: 5;"/>
    </HBox>

</VBox>
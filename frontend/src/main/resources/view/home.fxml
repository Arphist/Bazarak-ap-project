<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.HomeController">

    <!-- TOP: Header -->
    <top>
        <VBox spacing="12" styleClass="header-bar">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Bazarak" styleClass="heading-title"/>
                <Label fx:id="welcomeLabel" styleClass="sub-title"/>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="↻ Refresh" onAction="#refreshAds" styleClass="button-secondary"/>
            </HBox>

            <!-- Search Bar + Filter Toggle -->
            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="searchField" promptText="Search ads..." HBox.hgrow="ALWAYS"/>
                <Button text="Search" onAction="#handleSearch" styleClass="button-primary"/>
                <ToggleButton fx:id="filterToggleButton" text="Show Filters ▼" onAction="#toggleFilters" styleClass="button-secondary"/>
            </HBox>

            <!-- Advanced Filters Container -->
            <VBox fx:id="filterContainer" spacing="12" visible="false" managed="false" styleClass="filter-card">
                <padding>
                    <Insets top="12" right="15" bottom="12" left="15"/>
                </padding>
                <Label text="Advanced Filters" style="-fx-font-weight: bold;"/>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Category:"/>
                    <ComboBox fx:id="categoryCombo" promptText="All Categories" HBox.hgrow="ALWAYS"/>
                    <Label text="City:"/>
                    <ComboBox fx:id="cityCombo" promptText="All Cities" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Price Range:"/>
                    <TextField fx:id="minPriceField" promptText="Min" prefWidth="100"/>
                    <Label text="to"/>
                    <TextField fx:id="maxPriceField" promptText="Max" prefWidth="100"/>
                </HBox>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Sort By:"/>
                    <ComboBox fx:id="sortByCombo" prefWidth="200"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Button fx:id="clearFiltersButton" text="Clear Filters" onAction="#clearFilters" styleClass="button-secondary"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <!-- CENTER: Ad List -->
    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Active Ads" styleClass="heading-title" style="-fx-font-size: 18;"/>
            <ListView fx:id="adListView" VBox.vgrow="ALWAYS"/>
            <Label fx:id="errorLabel" styleClass="error-label"/>
        </VBox>
    </center>

    <!-- BOTTOM: Navigation Bar -->
    <bottom>
        <HBox spacing="12" alignment="CENTER" styleClass="header-bar">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Button text="Create Ad" onAction="#goToCreateAd" styleClass="button-primary"/>
            <Button text="Favorites" onAction="#goToFavorites" styleClass="button-secondary"/>
            <Button text="My Ads" onAction="#goToMyAds" styleClass="button-secondary"/><Button text="Profile" onAction="#goToProfile" styleClass="button-secondary"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="button-secondary"/>
        </HBox>
    </bottom>

</BorderPane>
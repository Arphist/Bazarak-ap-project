<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.MainController">

    <!-- TOP: Header -->
    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #2c3e50;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Bazarak" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="welcomeLabel" style="-fx-text-fill: #bdc3c7; -fx-font-size: 14;"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER">
                <TextField fx:id="searchField" promptText="Search ads..." HBox.hgrow="ALWAYS"
                           style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5;"/>
                <Button text="Search" onAction="#handleSearch"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20;"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: Ad List -->
    <center>
        <VBox spacing="10" style="-fx-padding: 20;">
            <Label text="Active Ads" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <ListView fx:id="adListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>
            <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12;"/>
        </VBox>
    </center>

    <!-- BOTTOM: Navigation -->
    <bottom>
        <HBox spacing="15" alignment="CENTER" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
            <Button text="Create Ad" onAction="#goToCreateAd"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 15;"/>
            <Button text="Favorites" onAction="#goToFavorites"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 8 15;"/>
            <Button text="Profile" onAction="#goToProfile"
                    style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-padding: 8 15;"/>

            <!-- Admin button (only visible for admins) -->
            <Button fx:id="adminButton"
                    text="Admin Panel"
                    onAction="#goToAdmin"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 15;"/>

            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-padding: 8 15;"/>
        </HBox>
    </bottom>

</BorderPane>
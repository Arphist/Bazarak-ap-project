<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" alignment="CENTER" style="-fx-padding: 40; -fx-background-color: #f5f5f5;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.controller.LoginController">

    <Label text="Bazarak" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Label text="Login to your account" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>

    <TextField fx:id="usernameField" promptText="Username" maxWidth="300"
               style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="300"
                   style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

    <Label fx:id="errorLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12;"/>

    <Button text="Login" onAction="#handleLogin" maxWidth="300" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5;"/>

    <Button text="Don't have an account? Register" onAction="#goToRegister" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-underline: true;"/>


    <Button text="Skip Login (Test Mode)" onAction="#handleSkipLogin" maxWidth="300"
            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5;"/>

</VBox>